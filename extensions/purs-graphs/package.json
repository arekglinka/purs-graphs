{
  "name": "purs-graphs",
  "displayName": "Purs Graphs",
  "description": "Live preview for Graphviz DOT (via viz.js WASM) and JSON graph definitions (via dagre layout) — powered by the purs-viz and purs-dagre PureScript bindings.",
  "version": "0.1.0",
  "publisher": "arekglinka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arekglinka/purs-graphs"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["graphviz", "dot", "dagre", "graph", "preview"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pursGraphs.previewDot",
        "title": "Purs Graphs: Preview DOT",
        "icon": "$(graph-line)"
      },
      {
        "command": "pursGraphs.previewGraph",
        "title": "Purs Graphs: Preview Graph (JSON)",
        "icon": "$(graph-scatter)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pursGraphs.previewDot",
          "when": "resourceLangId == dot",
          "group": "navigation"
        },
        {
          "command": "pursGraphs.previewGraph",
          "when": "resourceExtname == .graph.json",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pursGraphs.previewDot",
        "key": "ctrl+shift+g",
        "when": "editorTextFocus && resourceLangId == dot"
      }
    ],
    "languages": [
      {
        "id": "dot",
        "aliases": ["Graphviz DOT", "dot"],
        "extensions": [".dot", ".gv"]
      }
    ],
    "configuration": {
      "title": "Purs Graphs",
      "properties": {
        "pursGraphs.dotEngine": {
          "type": "string",
          "default": "dot",
          "enum": ["dot", "neato", "fdp", "circo", "twopi"],
          "description": "Graphviz layout engine used for DOT previews."
        }
      }
    }
  },
  "scripts": {
    "compile": "cd ../.. && spago build && purs-backend-es build --corefn-dir output --output-dir output-es && cd extensions/purs-graphs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run compile -- --production && npx @vscode/vsce package --no-dependencies -o purs-graphs.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.24.0"
  }
}
